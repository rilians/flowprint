# Supabase public project values (safe to expose in browser; RLS is mandatory).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Optional Gemini API key for server-side AI features. Use a newly rotated key.
GEMINI_API_KEY=replace_with_rotated_google_ai_studio_key
GEMINI_MODEL=gemini-3.6-flash

# Never add a service-role key or Gemini key to NEXT_PUBLIC_* or client code.
